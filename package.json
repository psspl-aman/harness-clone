{
  "name": "agentforge",
  "private": true,
  "version": "0.1.0",
  "description": "AgentForge \u2014 local-first agentic coding harness & agent factory",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @agentforge/daemon --filter @agentforge/web dev",
    "dev:daemon": "pnpm --filter @agentforge/daemon dev",
    "dev:web": "pnpm --filter @agentforge/web dev",
    "build": "pnpm -r build",
    "start": "pnpm -r --parallel --filter @agentforge/daemon --filter @agentforge/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @agentforge/daemon db:generate",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "node-pty",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
