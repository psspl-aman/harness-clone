# Where AgentForge stores its SQLite DB, logs and managed workspaces (default: ~/.agentforge)
AGENTFORGE_HOME=
# Daemon bind address/port
AGENTFORGE_HOST=127.0.0.1
AGENTFORGE_PORT=4317
# Web app → daemon URL (used by the Next.js app in the browser)
NEXT_PUBLIC_AGENTFORGE_DAEMON_URL=http://127.0.0.1:4317
