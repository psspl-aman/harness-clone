# Where AI Harness stores its SQLite DB, logs and managed workspaces (default: ~/.ai-harness)
AI_HARNESS_HOME=
# Daemon bind address/port
AI_HARNESS_HOST=127.0.0.1
AI_HARNESS_PORT=4317
# Web app → daemon URL (used by the Next.js app in the browser)
NEXT_PUBLIC_AI_HARNESS_DAEMON_URL=http://127.0.0.1:4317
